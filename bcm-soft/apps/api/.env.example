NODE_ENV=development
PORT=3000
TRUSTED_ORIGINS=http://localhost:5173
CSRF_HMAC_KEY=replace-with-at-least-32-random-bytes-encoded-as-base64url
RATE_LIMIT_HMAC_KEY=replace-with-at-least-32-random-bytes-encoded-as-base64url

# Auth0 Regular Web Application (ADR-008). The issuer is https://<your-tenant-domain>/.
# The local launcher reads the AUTH0_* client values from apps/api/.env; never commit real values.
AUTH0_ISSUER_URL=https://your-tenant.us.auth0.com/
AUTH0_CLIENT_ID=replace-with-the-auth0-application-client-id
AUTH0_CLIENT_SECRET=replace-with-the-auth0-application-client-secret
AUTH0_CALLBACK_URL=http://localhost:3000/api/auth/auth0/callback
WEB_APP_ORIGIN=http://localhost:5173
# Separate Machine-to-Machine application authorized for the Auth0 Management
# API with only the create:users and read:users scopes.
AUTH0_MANAGEMENT_CLIENT_ID=replace-with-the-machine-to-machine-client-id
AUTH0_MANAGEMENT_CLIENT_SECRET=replace-with-the-machine-to-machine-client-secret
AUTH0_DATABASE_CONNECTION=Username-Password-Authentication

# Code the one-time initial setup wizard asks for. Without it the wizard is
# disabled. The local launcher generates and prints one when it is missing.
SETUP_TOKEN=replace-with-at-least-32-random-characters
